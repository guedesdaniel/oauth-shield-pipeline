# Copy to .env (never commit .env).

# "local" writes Parquet to ./data; "s3" writes to the bucket created by Terraform.
STORAGE_BACKEND=local
S3_BUCKET=

# Only needed when STORAGE_BACKEND=s3. Use the access key of the IAM user
# "oauth-shield-airflow" created by Terraform (create the key in the AWS console).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2

# Linux only: your user id (run `id -u`). Windows/macOS can leave the default.
AIRFLOW_UID=50000
